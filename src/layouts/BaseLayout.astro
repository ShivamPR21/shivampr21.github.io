---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader/wght-italic.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = 'Shivam Pandey — AI Research Engineer',
  description = 'Research across embodied intelligence, world models, interpretability, reinforcement learning, and high-performance AI systems.',
  image,
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Shivam Pandey') ? title : `${title} — Shivam Pandey`;
const identityJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://shivampr21.com/#shivam-pandey',
      name: 'Shivam Pandey',
      url: 'https://shivampr21.com',
      jobTitle: 'AI Research Engineer',
      sameAs: ['https://github.com/ShivamPR21', 'https://www.linkedin.com/in/shivampr21'],
      knowsAbout: ['Embodied intelligence', 'World models', 'Reinforcement learning', 'Interpretability', 'GPU programming'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://shivampr21.com/#website',
      url: 'https://shivampr21.com',
      name: 'Shivam Pandey — Research Studio',
      author: { '@id': 'https://shivampr21.com/#shivam-pandey' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#11080b" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Shivam Pandey — Writing" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:creator" content="@ShivamPR21" />
    <script type="application/ld+json" set:html={JSON.stringify(identityJsonLd)} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
