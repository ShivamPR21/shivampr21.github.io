---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props { headings: Heading[]; }
const entries = Astro.props.headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<aside class="article-toc" aria-label="On this page">
  <p>On this page</p>
  <ol>
    {entries.map((heading) => (
      <li class={'depth-' + heading.depth}><a href={'#' + heading.slug}>{heading.text}</a></li>
    ))}
  </ol>
</aside>

<details class="article-toc-mobile">
  <summary>On this page</summary>
  <nav aria-label="Article sections">
    <ol>
      {entries.map((heading) => (
        <li class={'depth-' + heading.depth}><a href={'#' + heading.slug}>{heading.text}</a></li>
      ))}
    </ol>
  </nav>
</details>
