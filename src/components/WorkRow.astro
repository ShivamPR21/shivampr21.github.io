---
interface Props {
  index: string;
  title: string;
  kind: string;
  description: string;
  href: string;
  meta: string;
}
const { index, title, kind, description, href, meta } = Astro.props;
const external = href.startsWith('http');
---

<a class="work-row" href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
  <span class="work-index">{index}</span>
  <div><p>{kind}</p><h3>{title}</h3></div>
  <p class="work-description">{description}</p>
  <span class="work-meta">{meta}</span>
  <span class="work-open" aria-hidden="true">↗</span>
</a>
