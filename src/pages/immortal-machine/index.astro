---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImmortalMachineHome from '../../components/ImmortalMachineHome.astro';
import StaticRedirect from '../../components/StaticRedirect.astro';
import { publicationActive, PUBLICATION_ORIGIN } from '../../lib/publication';
---
{publicationActive ? (
  <StaticRedirect target={`${PUBLICATION_ORIGIN}/`} title="Immortal Machine" />
) : (
  <BaseLayout title="Immortal Machine" description="Immortal Machine is Shivam Pandey’s technical publication for essays, experiments, implementations, and research series.">
    <ImmortalMachineHome target="personal" />
  </BaseLayout>
)}
