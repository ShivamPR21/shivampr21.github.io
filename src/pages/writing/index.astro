---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postHref, publicationHomeHref } from '../../lib/publication';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || (b.data.seriesOrder ?? 0) - (a.data.seriesOrder ?? 0));
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
---

<BaseLayout title="Writing" description="Mathematical references and technical writing by Shivam Pandey on calculus, tensor operators, autodiff, learning systems, and GPU kernels.">
  <header class="page-head page-head--writing shell">
    <p class="section-index">02 / Writing</p>
    <h1>Working notes from<br/><em>inside the machine.</em></h1>
    <p>Mathematical references, derivations, implementations, and experiments tracing the path from an idea to a working system. Explore the <a href={publicationHomeHref()}>Immortal Machine</a> publication and the KERNELIZED archive alongside new research notes.</p>
  </header>

  <section class="series-intro shell">
    <div><span>Notes &amp; references</span><h2>From foundations<br/>to implementation.</h2></div>
    <p>Calculus, tensor derivatives, and integral operators, alongside the KERNELIZED series on reduction, softmax, and FlashAttention.</p>
  </section>

  <ol class="post-list shell">
    {posts.map((post) => (
      <li>
        <a href={postHref(post)}>
          <span class="post-number">{String(post.data.seriesOrder ?? 0).padStart(2, '0')}</span>
          <div><p>{post.data.series ? post.data.series + ' · ' : ''}{post.data.categories.slice(0, 3).join(' · ')}</p><h2>{post.data.title}</h2><span>{post.data.description}</span></div>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span class="post-open" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
