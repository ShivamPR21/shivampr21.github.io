---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import StaticRedirect from '../../components/StaticRedirect.astro';
import { isPublicationPost, publicationActive, postUrl } from '../../lib/publication';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'writing'>; }
const { post } = Astro.props;
const canonical = postUrl(post, 'personal');
const moved = isPublicationPost(post) && publicationActive;
---
{moved ? (
  <StaticRedirect target={canonical} title={post.data.title} />
) : (
  <BaseLayout title={post.data.title} description={post.data.description} image={post.data.image} article>
    <ArticlePage post={post} canonical={canonical} />
  </BaseLayout>
)}
